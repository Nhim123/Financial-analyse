# Sao chép file này thành ".env" (cùng thư mục) rồi điền giá trị.
# File .env chứa token bí mật — KHÔNG gửi cho người khác.

# --- Telegram (để trống = tắt thông báo) ---
# Lấy token: mở Telegram, chat với @BotFather, gõ /newbot và làm theo hướng dẫn.
TELEGRAM_BOT_TOKEN=
# Lấy chat id: nhắn /start cho bot, rồi mở http://localhost:8000/api/notify/chat-id
TELEGRAM_CHAT_ID=

# Giờ gửi bản tin định kỳ (giờ Việt Nam), cách nhau dấu phẩy. Để trống = không gửi bản tin.
TELEGRAM_DIGEST_HOURS=8,20

# 1 = chỉ đẩy ngay tin ảnh hưởng Cao đã được >=2 nguồn xác nhận; 0 = mọi tin ảnh hưởng Cao.
TELEGRAM_NEWS_REQUIRE_VERIFIED=0

# Chỉ đẩy ngay tin đăng trong N giờ gần nhất.
TELEGRAM_NEWS_MAX_AGE_HOURS=6

# --- Tin tức mới (tin nhắn "📰 Tin tức mới", chia theo nhóm như màn hình chính) ---
# important = chỉ tin ảnh hưởng Cao; all = mọi tin mới.
TELEGRAM_NEWS_MODE=important
# Nhóm nhận tin: stock (chứng khoán TG), commodity (vàng/dầu), crypto, vn (CK & DN Việt Nam).
# Cách nhau dấu phẩy, vd: vn,crypto. Để trống = tất cả nhóm.
TELEGRAM_NEWS_GROUPS=
# Số tin tối đa mỗi tin nhắn (tin dư chuyển sang chu kỳ sau).
TELEGRAM_MAX_NEWS_PER_ALERT=8
# Giờ yên lặng (giờ VN): tin vẫn gửi nhưng không reo chuông. Để trống = luôn reo.
TELEGRAM_SILENT_HOURS=23-6

# Chỉ dùng khi mạng chặn Telegram: http://host:port hoặc socks5://host:port
TELEGRAM_PROXY=

# Địa chỉ dashboard chèn vào tin nhắn (đổi thành IP máy trong mạng LAN để mở từ điện thoại).
DASHBOARD_URL=http://localhost:8000
